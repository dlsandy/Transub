{
  "name": "transub",
  "version": "3.1.2",
  "description": "Windows 桌面字幕工具：基于 TransWithAI 的批量转写/翻译，以及 SRT/VTT/LRC 结构化字幕编辑与音视频同步预览",
  "main": "electron/main.js",
  "author": "Transub",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dlsandy/Transub.git"
  },
  "bugs": {
    "url": "https://github.com/dlsandy/Transub/issues"
  },
  "homepage": "https://github.com/dlsandy/Transub#readme",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "node tools/setup-electron.js && node tools/setup-vendor-assets.js && node tools/build-css.js",
    "sync:jassub": "node tools/sync-jassub-vendor.js",
    "setup:ffmpeg": "node tools/setup-ffmpeg.js",
    "start": "node tools/patch-electron-icon.js && electron .",
    "start:editor": "node tools/patch-electron-icon.js && electron . --subtitle-editor-only",
    "build:css": "node tools/build-css.js",
    "build:renderer": "node tools/build-renderer.js",
    "build:advanced": "node tools/build-advanced-module.js",
    "check:release": "node tools/check-release-ready.js",
    "verify:packaging": "node tools/verify-packaging.js",
    "smoke:preflight": "node tools/smoke-preflight.js",
    "ensure:bundled-models": "node tools/ensure-bundled-models.js",
    "ensure:bundled-wheels": "node tools/ensure-bundled-wheels.js",
    "ensure:bundled-tdp": "node tools/encode-tdp-pack.js",
    "ensure:packaging": "npm run ensure:bundled-wheels && npm run ensure:bundled-models && npm run ensure:bundled-tdp",
    "generate:update-manifest": "node tools/generate-update-manifest.js",
    "pack:website-update": "node tools/pack-website-update.js",
    "pack": "powershell -ExecutionPolicy Bypass -File tools/build.ps1 -Target dir -SkipTests",
    "dist": "powershell -ExecutionPolicy Bypass -File tools/build.ps1 -Target zip -SkipTests",
    "build": "powershell -ExecutionPolicy Bypass -File tools/build.ps1 -Target zip",
    "build:dir": "powershell -ExecutionPolicy Bypass -File tools/build.ps1 -Target dir",
    "build:zip": "powershell -ExecutionPolicy Bypass -File tools/build.ps1 -Target zip -SkipTests",
    "build:release": "powershell -ExecutionPolicy Bypass -File tools/build.ps1 -Target zip",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "i18n:sync": "node tools/sync-i18n-catalogs.js",
    "i18n:seed-hant": "node tools/seed-zh-hant-tw.js",
    "fetch:av-makers": "node tools/fetch-av-makers.js",
    "encode:tdp": "node tools/encode-tdp-pack.js",
    "encode:tdp:sign": "node tools/encode-tdp-pack.js --sign",
    "report:mt-conflicts": "node tools/mt-sanitize-conflict-report.js",
    "scan:mt-latest": "node tools/mt-train/scan-latest-batch.js",
    "train:mt": "node tools/mt-train/server.js",
    "train:mt:open": "node tools/mt-train/server.js --open",
    "train:mt:restart": "node tools/mt-train/server.js --force --open",
    "train:mt:idle": "node tools/mt-train/server.js --force --idle-watch",
    "lint": "eslint electron src/js tests tools --max-warnings 200",
    "lint:fix": "eslint electron src/js tests tools --fix",
    "format": "prettier --write \"electron/**/*.js\" \"src/js/**/*.js\" \"tests/**/*.js\" \"tools/**/*.js\"",
    "format:check": "prettier --check \"electron/**/*.js\" \"src/js/**/*.js\" \"tests/**/*.js\" \"tools/**/*.js\"",
    "icons": "node tools/generate-icons.js"
  },
  "dependencies": {
    "jassub": "^2.5.14",
    "json5": "^2.2.3",
    "opencc-js": "^1.4.1",
    "undici": "^8.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@vitest/coverage-v8": "^3.2.4",
    "autoprefixer": "^10.4.21",
    "electron": "^43.1.1",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.5",
    "eslint": "^9.28.0",
    "globals": "^16.2.0",
    "png-to-ico": "^2.1.8",
    "prettier": "^3.5.3",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.17",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "com.transub.app",
    "productName": "Transub",
    "copyright": "Copyright © 2026 Transub",
    "directories": {
      "output": "dist",
      "buildResources": "electron"
    },
    "icon": "app.ico",
    "electronLanguages": [
      "zh-CN",
      "zh-TW",
      "en-US"
    ],
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "files": [
      "electron/**/*",
      "!electron/advanced-context-reconstruct.js",
      "!electron/advanced-film-reconstruct.js",
      "!electron/advanced-bilingual-semantic.js",
      "!electron/advanced-reconstruct-runtime.js",
      "!electron/advanced-smart-translate.js",
      "package.json",
      "renderer-dist/**/*",
      "!renderer-dist/js/advanced-film-reconstruct-core.js",
      "!renderer-dist/js/advanced-smart-translate-core.js",
      "!renderer-dist/js/smart-translate-verify-core.js",
      "!renderer-dist/js/smart-translate-address-core.js",
      "src/js/*-core.js",
      "!src/js/advanced-film-reconstruct-core.js",
      "!src/js/advanced-smart-translate-core.js",
      "!src/js/smart-translate-verify-core.js",
      "!src/js/smart-translate-address-core.js",
      "src/js/i18n-catalogs.js",
      "src/js/mt-opaque-strings.js",
      "src/js/mt-sanitize-lexicon.js",
      "src/js/subtitle-editor/silence-split-plan.js",
      "src/vendor/opencc-js/**/*",
      "src/vendor/jassub/**/*",
      "src/js/tone-adapt.tz1",
      "src/js/av-makers.am1",
      "src/js/av-makers-embed.js",
      "shared/ja-asr-domain-fixes.json",
      "shared/mt-trained-remaps.json",
      "shared/tdp/tdp-bundled.tpack",
      "shared/i18n/**/*",
      "tools/mt-train/**/*",
      "!docs",
      "!docs/**/*"
    ],
    "asarUnpack": [
      "electron/app.ico",
      "electron/editor-app.ico",
      "electron/tray-icon-subtitle*.png",
      "electron/icon-256.png",
      "electron/editor-icon-256.png"
    ],
    "extraResources": [
      {
        "from": "electron/app.ico",
        "to": "icons/app.ico"
      },
      {
        "from": "electron/editor-app.ico",
        "to": "icons/editor-app.ico"
      }
    ],
    "extraFiles": [
      {
        "from": "_advanced",
        "to": "_advanced",
        "filter": [
          "index.js",
          "MODULE.json"
        ]
      },
      {
        "from": "shared/ja-asr-domain-fixes.json",
        "to": "shared/ja-asr-domain-fixes.json"
      },
      {
        "from": "shared/tdp/tdp-bundled.tpack",
        "to": "shared/tdp/tdp-bundled.tpack"
      },
      {
        "from": "_internal",
        "to": "_internal",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "transub-engine",
        "to": "transub-engine",
        "filter": [
          "**/*",
          "!docs/**",
          "!wheels-edition/**",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!**/.venv/**",
          "!**/venv/**",
          "!**/_internal/bin/*.exe",
          "!**/_internal/bin/*.dll",
          "!**/.cache/**",
          "!models/asr/**",
          "!models/mt/**",
          "!models/vad/**",
          "!**/site-packages/~*/**",
          "!**/site-packages/nvidia/**",
          "!**/site-packages/nvidia_*.dist-info/**",
          "!**/site-packages/torch/**",
          "!**/site-packages/torch-*.dist-info/**",
          "!**/site-packages/torchaudio/**",
          "!**/site-packages/torchaudio-*.dist-info/**",
          "!**/site-packages/torchvision/**",
          "!**/site-packages/torchvision-*.dist-info/**",
          "!**/site-packages/onnxruntime/**",
          "!**/site-packages/onnxruntime_*/**",
          "!**/site-packages/onnxruntime-*.dist-info/**",
          "!**/site-packages/ctranslate2/**",
          "!**/site-packages/ctranslate2-*.dist-info/**",
          "!**/site-packages/whisper/**",
          "!**/site-packages/openai_whisper-*.dist-info/**",
          "!**/site-packages/demucs/**",
          "!**/site-packages/demucs-*.dist-info/**",
          "!**/site-packages/av/**",
          "!**/site-packages/av-*.dist-info/**",
          "!**/site-packages/av.libs/**",
          "!**/site-packages/numba/**",
          "!**/site-packages/numba-*.dist-info/**",
          "!**/site-packages/llvmlite/**",
          "!**/site-packages/llvmlite-*.dist-info/**",
          "!**/site-packages/scipy/**",
          "!**/site-packages/scipy-*.dist-info/**",
          "!**/site-packages/scipy.libs/**",
          "!**/site-packages/jieba/**",
          "!**/site-packages/jieba-*.dist-info/**",
          "!**/site-packages/sklearn/**",
          "!**/site-packages/scikit_learn-*.dist-info/**",
          "!**/site-packages/scikit-learn-*.dist-info/**",
          "!**/site-packages/sympy/**",
          "!**/site-packages/sympy-*.dist-info/**",
          "!**/site-packages/modelscope/**",
          "!**/site-packages/modelscope-*.dist-info/**",
          "!**/site-packages/transformers/**",
          "!**/site-packages/transformers-*.dist-info/**",
          "!**/*.onnx",
          "!**/*.pt",
          "!**/*.pth",
          "!**/*.bin",
          "!**/*.safetensors",
          "!**/*.gguf",
          "!**/*.ct2",
          "!**/*.ckpt",
          "models/asr/whisper-tiny/**",
          "models/vad/fsmn-vad/**",
          "models/vad/firered-vad/**",
          "!models/**/.cache/**"
        ]
      }
    ],
    "asar": true,
    "disableAsarIntegrity": true,
    "afterPack": "tools/after-pack.js",
    "extraMetadata": {
      "description": "Transub 字幕工具"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "dlsandy",
        "repo": "Transub"
      }
    ],
    "win": {
      "icon": "app.ico",
      "signExecutable": false,
      "signAndEditExecutable": true,
      "forceCodeSigning": false,
      "verifyUpdateCodeSignature": false,
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
